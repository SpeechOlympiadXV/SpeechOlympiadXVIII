# Copy to .env for local development. Both values are exposed in the client
# bundle by design (the VITE_ prefix inlines them), so only ever put the
# publishable/anon key here — never the service_role key.
#
# The same two names must exist as GitHub Actions repository secrets for the
# deploy workflow (.github/workflows/deploy.yml) to build correctly.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
